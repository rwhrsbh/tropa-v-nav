// Знамения, третья тетрадь: «Жертва» (один платит fx, все получают all) и «Раскол»
// (каждый идёт своей дорогой, но всем вместе одной нельзя), а с ними ещё голосования и личные.
// Раскол упрощён против документа: отряд не расходится по двум узлам карты, а делит один выбор.
[
    (id: "krada", kind: Sacrifice, act: 1,
        options: [(id: "burn", fx: [RemoveRandomCard], all: [Relic]), (id: "refuse")]),
    (id: "blood_oak", kind: Sacrifice, act: 1,
        options: [(id: "feed", fx: [HpPct(-20)], all: [UpgradeRandomCard]), (id: "refuse")]),
    (id: "forked_path", kind: Schism, act: 1,
        options: [(id: "left", fx: [Gold(45)]), (id: "right", fx: [HpPct(15)])]),
    (id: "wolf_shepherd", kind: Vote, act: 1,
        options: [(id: "tribute", fx: [Gold(-25)]), (id: "defy", fx: [HpPct(-10), Relic]), (id: "bow", fx: [MaxHp(3)])]),
    (id: "mushroom_ring", kind: Personal, act: 1,
        options: [(id: "step", fx: [RandomCard(Rare), Card("morok")]), (id: "pick", fx: [Potion]), (id: "skirt")]),
    (id: "bee_tree", kind: Personal, act: 1,
        options: [(id: "reach", fx: [MaxHp(4), Hp(-6)]), (id: "smoke", price: 15, fx: [Potion]), (id: "leave")]),
    (id: "lost_hunter", kind: Sacrifice, act: 1,
        options: [(id: "share", fx: [HpPct(-10)], all: [Gold(35)]), (id: "refuse")]),
    (id: "owl_omen", kind: Vote, act: 1,
        options: [(id: "follow", fx: [RandomCard(Uncommon)]), (id: "wait", fx: [HpPct(10)])]),
    (id: "hollow_log", kind: Personal, act: 1,
        options: [(id: "crawl", fx: [Gold(40), Hp(-5)]), (id: "pass")]),
    (id: "two_bridges", kind: Schism, act: 1,
        options: [(id: "bridge", fx: [Relic, HpPct(-15)]), (id: "ford", fx: [Gold(20)])]),
    (id: "charcoal_burner", kind: Personal, act: 1,
        options: [(id: "temper", price: 35, fx: [UpgradeRandomCard]), (id: "sit", fx: [HpPct(12)]), (id: "leave")]),
    (id: "empty_cradle", kind: Sacrifice, act: 2,
        options: [(id: "rock", fx: [Card("grief")], all: [MaxHp(5)]), (id: "leave")]),
    (id: "plague_cart", kind: Sacrifice, act: 2,
        options: [(id: "pull", fx: [HpPct(-25)], all: [Relic]), (id: "aside")]),
    (id: "church_and_tavern", kind: Schism, act: 2,
        options: [(id: "chapel", fx: [RemoveRandomCard]), (id: "tavern", fx: [HpPct(20), Gold(-15)])]),
    (id: "gallows_crows", kind: Vote, act: 2,
        options: [(id: "feed", fx: [Gold(-20), Potion]), (id: "scare", fx: [HpPct(-8), Gold(30)]), (id: "go")]),
    (id: "drowned_bell", kind: Personal, act: 2,
        options: [(id: "ring", fx: [UpgradeRandomCard, Card("evil_dream")]), (id: "dive", fx: [Gold(60), HpPct(-15)]), (id: "listen")]),
    (id: "widow_bread", kind: Personal, act: 2,
        options: [(id: "eat", fx: [HpPct(25)]), (id: "pay", price: 30, fx: [MaxHp(6)]), (id: "refuse")]),
    (id: "swamp_fork", kind: Schism, act: 2,
        options: [(id: "causeway", fx: [Gold(40)]), (id: "reeds", fx: [Potion, Hp(-5)])]),
    (id: "black_rooster", kind: Sacrifice, act: 2,
        options: [(id: "buy", price: 50, all: [UpgradeRandomCard]), (id: "no")]),
    (id: "cellar_door", kind: Personal, act: 2,
        options: [(id: "down", fx: [Relic, Card("bad_omen")]), (id: "nail", fx: [Gold(25)])]),
    (id: "mirror_house", kind: Vote, act: 2,
        options: [(id: "break", fx: [RemoveRandomCard, HpPct(-10)]), (id: "cover", fx: [HpPct(10)]), (id: "look", fx: [RandomCard(Rare), Card("shame")])]),
    (id: "river_smorodina", kind: Sacrifice, act: 3,
        options: [(id: "toll", fx: [MaxHp(-6)], all: [Relic]), (id: "back")]),
    (id: "kalinov_bridge", kind: Schism, act: 3,
        options: [(id: "over", fx: [Relic, HpPct(-20)]), (id: "under", fx: [RemoveRandomCard])]),
    (id: "ancestors_table", kind: Vote, act: 3,
        options: [(id: "sit", fx: [HpPct(30)]), (id: "bread", fx: [Potion]), (id: "bow", fx: [UpgradeRandomCard, HpPct(-10)])]),
    (id: "nameless_grave", kind: Personal, act: 3,
        options: [(id: "name", fx: [MaxHp(-4), RandomCard(Rare)]), (id: "dig", fx: [Gold(70), Card("blood_debt")]), (id: "pass")]),
    (id: "shadow_market", kind: Personal, act: 3,
        options: [(id: "relic", price: 60, fx: [Relic]), (id: "potion", price: 30, fx: [Potion]), (id: "memory", fx: [Gold(60), Card("orphanhood")])]),
    (id: "sleeping_host", kind: Sacrifice, act: 3,
        options: [(id: "watch", fx: [HpPct(-15)], all: [HpPct(25)]), (id: "on")]),
    (id: "two_fires", kind: Schism, act: 3,
        options: [(id: "white", fx: [HpPct(25)]), (id: "black", fx: [UpgradeRandomCard, HpPct(-10)])]),
    (id: "gamayun", kind: Vote, act: 3,
        options: [(id: "road", fx: [Gold(50)]), (id: "death", fx: [MaxHp(5)]), (id: "nothing")]),
    (id: "last_candle", kind: Sacrifice, act: 3,
        options: [(id: "carry", fx: [Card("toska")], all: [UpgradeRandomCard]), (id: "dark")]),
    (
        id: "needle_crone", kind: Personal, for_the_maimed: true,
        options: [
            (id: "head", fx: [SewHeadOn]),
            (id: "arm", fx: [SewLimbOn]),
            (id: "pass"),
        ],
    ),
    // the hollow that plays for stakes: met like the pedlar, never as one of the tales
    (
        id: "greedy_hollow", kind: Personal,
        options: [
            (id: "play", fx: [Gamble]),
            (id: "pass"),
        ],
    ),
]
