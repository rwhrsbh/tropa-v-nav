        id: "sk_tumble", hero: "skomoroh", kind: Skill, cost: 1,
        effects: [Block(N(4), Me), Draw(N(2)), Discard(N(1))],
        up: (effects: [Block(N(6), Me), Draw(N(2)), Discard(N(1))]),
