// Скоморох: Личины (Медведь, Коза, Мара) и Эхо.
[
    (
        id: "sk_dance", hero: "skomoroh", kind: Attack, cost: 1, target: Enemy,
        effects: [Damage(N(5), Target)],
        up: (effects: [Damage(N(8), Target)]),
    ),
    (
        id: "sk_defend", hero: "skomoroh", kind: Skill, cost: 1,
