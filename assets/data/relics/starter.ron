// Стартовые реликвии героев.
[
    (
        // Отцовский оберег: в начале боя Богатырь получает 6 щита, каждый союзник — 3
        id: "father_amulet", rarity: Starter, hero: "bogatyr",
        passives: [(on: CombatStart, effects: [Block(N(6), Me), Block(N(3), OtherFriends)])],
    ),
    (
        // Куколка-мотанка: в начале боя случайный враг получает 3 Гнили
        id: "motanka_doll", rarity: Starter, hero: "vorozheya",
        passives: [(on: CombatStart, effects: [Apply(Rot, N(3), RandomFoe)])],
    ),
    (
        // Посох громового дуба: первая реза в каждом бою срабатывает дважды
        id: "thunder_staff", rarity: Starter, hero: "volhv",
        passives: [(on: CombatStart, effects: [Flag("first_rune_twice", 1)])],
    ),
    (
        // Клык на шнурке: при первом обращении в бою доберите 2 карты
        id: "fang_on_cord", rarity: Starter, hero: "volkolak",
        passives: [(on: Shifted, effects: [Once("fang", [Draw(N(2))])])],
    ),
    (
        // Берестяной котелок: Котёл вмещает 4 травы
        id: "birch_pot", rarity: Starter, hero: "znaharka",
        passives: [(on: CombatStart, effects: [Flag("big_cauldron", 1)])],
    ),
    (
        // Бубенцы: первая смена личины за ход добирает 1 карту
        id: "jingle_bells", rarity: Starter, hero: "skomoroh",
        passives: [(on: MaskChanged, effects: [OncePerTurn("bells", [Draw(N(1))])])],
    ),
    // ---- Капище: другие стартовые реликвии, по две на героя ----
    (id: "bog_alt_whetted_mace", rarity: Starter, hero: "bogatyr", passives: [(on: CombatStart, effects: [Apply(Valor, N(3), Me)])]),
    (id: "bog_alt_brother_bracelet", rarity: Starter, hero: "bogatyr", passives: [(on: TurnStart, effects: [Once("bog_alt_bracelet", [Block(N(4), AllFriends), Draw(N(1))])])]),
    (id: "vor_alt_raven_claw", rarity: Starter, hero: "vorozheya", passives: [(on: CombatStart, effects: [Apply(Hex, N(2), AllFoes)])]),
    (id: "vor_alt_tear_vial", rarity: Starter, hero: "vorozheya", passives: [(on: Hurt, effects: [Once("vor_alt_vial", [Heal(N(6), Me)])])]),
    (id: "vol_alt_carved_bone", rarity: Starter, hero: "volhv", passives: [(on: CombatStart, effects: [Rune(Thunder, Me)])]),
    (id: "vol_alt_wax_tablet", rarity: Starter, hero: "volhv", passives: [(on: TurnStart, effects: [Once("vol_alt_tablet", [Draw(N(2))])])]),
    (id: "wolf_alt_bitten_coin", rarity: Starter, hero: "volkolak", passives: [(on: Kill, effects: [Heal(N(2), Me)])]),
    (id: "wolf_alt_wolf_berry", rarity: Starter, hero: "volkolak", passives: [(on: CombatStart, effects: [Apply(Bleed, N(2), AllFoes)])]),
    (id: "zn_alt_herb_knife", rarity: Starter, hero: "znaharka", passives: [(on: CombatStart, effects: [Herb("wormwood")])]),
    (id: "zn_alt_herb_pouch", rarity: Starter, hero: "znaharka", passives: [(on: TurnEnd, effects: [Once("zn_alt_pouch", [Heal(N(3), AllFriends)])])]),
    (id: "sk_alt_fools_cap", rarity: Starter, hero: "skomoroh", passives: [(on: CombatStart, effects: [Mask(Goat), Block(N(4), Me)])]),
    (id: "sk_alt_bear_tooth", rarity: Starter, hero: "skomoroh", passives: [(on: CombatStart, effects: [Mask(Bear)])]),
    (
        // Щука в ведре: в начале каждого хода кусает случайного врага на 3
        id: "em_pike_bucket", rarity: Starter, hero: "emelya",
        passives: [(on: TurnStart, effects: [Damage(N(3), RandomFoe)])],
    ),
    (id: "em_alt_warm_bricks", rarity: Starter, hero: "emelya", passives: [(on: TurnStart, effects: [Block(N(3), Me)])]),
    (id: "em_alt_dry_crust", rarity: Starter, hero: "emelya", passives: [(on: CombatStart, effects: [Heal(N(4), Me)])]),
    (id: "em_r_pillow", rarity: Common, hero: "emelya", passives: [(on: TurnStart, effects: [Apply(Drowse, N(1), Me)])]),
    (id: "em_r_quilt", rarity: Common, hero: "emelya", passives: [(on: CombatStart, effects: [Block(N(5), Me), Apply(Drowse, N(2), Me)])]),
    (id: "em_r_valenki", rarity: Common, hero: "emelya", passives: [(on: TurnStart, effects: [Block(N(2), Me)])]),
    (id: "em_r_kvass", rarity: Common, hero: "emelya", passives: [(on: TurnEnd, effects: [If(Has(Drowse, Me, 5), [Heal(N(2), Me)], [])])]),
    (id: "em_r_bait", rarity: Common, hero: "emelya", passives: [(on: Kill, effects: [Apply(Drowse, N(2), Me)])]),
    (id: "em_r_sack", rarity: Common, hero: "emelya", passives: [(on: CombatStart, effects: [Apply(Drowse, N(3), Me)])]),
    (id: "em_r_poker", rarity: Uncommon, hero: "emelya", passives: [(on: AttackPlayed, effects: [OncePerTurn("em_poker", [Damage(N(2), AllFoes)])])]),
    (id: "em_r_tongs", rarity: Uncommon, hero: "emelya", passives: [(on: SkillPlayed, effects: [OncePerTurn("em_tongs", [Apply(Drowse, N(1), Me)])])]),
    (id: "em_r_net", rarity: Uncommon, hero: "emelya", passives: [(on: TurnStart, effects: [Every("em_net", 4, [Apply(Stun, N(1), RandomFoe)])])]),
    (id: "em_r_scale", rarity: Uncommon, hero: "emelya", passives: [(on: Hurt, effects: [OncePerTurn("em_r_scale0", [Damage(N(4), RandomFoe)])])]),
    (id: "em_r_logs", rarity: Uncommon, hero: "emelya", passives: [(on: TurnEnd, effects: [Block(N(3), Me)])]),
    (id: "em_r_ring", rarity: Rare, hero: "emelya", passives: [(on: TurnStart, effects: [Every("pike_ring", 3, [PikeWill])])]),
    (id: "em_r_crown", rarity: Rare, hero: "emelya", passives: [(on: CombatStart, effects: [Energy(N(1), Me), Apply(Drowse, N(2), Me)])]),
    (id: "em_r_bell", rarity: Rare, hero: "emelya", passives: [(on: Kill, effects: [PikeWill])]),
    (id: "em_r_featherbed", rarity: Rare, hero: "emelya", passives: [(on: TurnEnd, effects: [Apply(Drowse, N(2), Me)])]),
]
