// Реликвии Книги сказа: по одной за тайну каждого акта (склеенные листы, docs/book_secrets.md).
// pool: Book — выпадают как обычные, только когда тайну хоть раз нашли; их действие задано в правилах
// (run.rs: SECRET_RELICS), а не здесь.
[
    // Котомка путника: в начале каждого акта — случайное зелье
    (id: "kotomka", pool: Book, rarity: Rare),
    // Стёртое имя: первый раз за бой, когда герой должен пасть, он остаётся с 1 здоровьем
    (id: "erased_name", pool: Book, rarity: Rare),
    // Ледяной сказ: проклятие можно сыграть за 1 — сгорает и даёт 4 щита
    (id: "ice_tale", pool: Book, rarity: Rare),
    // Недослушанный сказ: закрыл книгу, не дочитав, — 15 золота и минус одно проклятие
    (id: "unheard_tale", pool: Book, rarity: Rare),
    // Осколок Алатыря: в начале каждого боя — 6 щита и очищение случайного ослабления
    (id: "alatyr_heart", pool: Book, rarity: Rare, passives: [(on: CombatStart, effects: [Block(N(6), Me), Cleanse(Me)])]),
]
